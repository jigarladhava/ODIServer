    "node-red-contrib-modbus": "^5.43.0",
    "pino": "^9.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.13",
    "jsmodbus": "^4.0.8"
